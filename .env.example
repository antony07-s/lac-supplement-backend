NODE_ENV=production
PORT=5000

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

CLIENT_URL=https://www.ayusydah.com
# Comma-separated browser origins allowed to call this API. Include both domain variants.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:4173,https://ayusydah.com,https://www.ayusydah.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PayPal: PAYPAL_ENV must be live in production. The client ID is public and
# belongs only in the storefront's VITE_PAYPAL_CLIENT_ID, never the secret.
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=your-live-paypal-client-id
PAYPAL_CLIENT_SECRET=your-live-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-live-webhook-id

# Razorpay credentials remain on the API. Configure payment.captured and
# order.paid webhooks to https://your-api.example/api/razorpay/webhook.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Ringgit per kilogram. Values must be supplied by the client before enabling checkout.
WEST_MALAYSIA_SHIPPING_RATE_PER_KG=PLACEHOLDER
EAST_MALAYSIA_SHIPPING_RATE_PER_KG=PLACEHOLDER
DEFAULT_PRODUCT_WEIGHT_KG=1
DISCOUNT_ABOVE_1000_THRESHOLD=1000
DISCOUNT_ABOVE_1000_TYPE=amount
DISCOUNT_ABOVE_1000=PLACEHOLDER

EMAIL_USER=
EMAIL_PASS=

RESEND_API_KEY=
EMAIL_FROM=
CONTACT_RECIPIENT=your-email@example.com
