NODE_ENV=production
PORT=5000

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

CLIENT_URL=https://your-store.example
CLIENT_ORIGINS=http://localhost:5173,https://your-store.example,https://www.your-store.example

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_test_webhook_secret

EMAIL_USER=
EMAIL_PASS=

RESEND_API_KEY=
EMAIL_FROM=
CONTACT_RECIPIENT=your-email@example.com
